/* ==== ESTILOS BASE ==== */
QWidget {
    background-color: #FAF5F5;
    color: #333333;
    font-family: "Segoe UI", "Roboto", sans-serif;
    font-size: 16px;
}

/* ==== BARRA LATERAL ==== */
#BarraLateral {
    background-color: #FFF0F5;
    border-right: 1px solid #FFD1DC;
    padding: 15px;
}

/* ==== BOTONES DEL SIDEBAR ==== */
#botonSidebar {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #FFD1DC;
    border-radius: 8px;
    font-size: 16px;
    font-weight: normal;
    padding: 12px;
    text-align: center;
    margin: 5px 0;
}

#botonSidebar:hover {
    background-color: #FFE4E9;
    border-color: #FF9EB5;
}

#botonSidebar:pressed {
    background-color: #FFD1DC;
}

/* ==== SECCIÓN PRINCIPAL ==== */
#SeccionPrincipal {
    background-color: #FFFFFF;
    border-radius: 10px;
    margin: 10px;
    padding: 25px;
    border: 1px solid #FFE4E9;
}

/* ==== TITULOS Y TEXTOS ==== */
QLabel#tituloPrincipal {
    font-size: 20px;
    font-weight: bold;
    color: #D94D73;
    margin-bottom: 15px;
}

QLabel#tituloSeccion {
    font-size: 18px;
    font-weight: bold;
    color: #333333;
    margin-bottom: 10px;
}

QLabel {
    font-size: 16px;
    color: #555555;
}

/* ==== CAMPOS DE FORMULARIO ==== */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #FFD1DC;
    border-radius: 6px;
    color: #333333;
    padding: 8px 10px;
    font-size: 16px;
    min-height: 20px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #D94D73;
    background-color: #FFF5F7;
}

/* ==== BOTONES GENERALES ==== */
QPushButton {
    background-color: #D94D73;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 16px;
    font-weight: bold;
    padding: 10px 15px;
    min-height: 25px;
}

QPushButton:hover {
    background-color: #C43D63;
}

QPushButton:pressed {
    background-color: #B02D53;
}

/* ==== GROUP BOXES ==== */
QGroupBox {
    font-weight: bold;
    font-size: 16px;
    color: #D94D73;
    border: 1px solid #FFD1DC;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px 0 5px;
}

/* ==== LISTAS ==== */
QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #FFD1DC;
    border-radius: 6px;
    font-size: 16px;
    outline: none;
}

QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid #FFE4E9;
}

QListWidget::item:selected {
    background-color: #FFE4E9;
    color: #333333;
}

/* ==== SCROLLBAR SIMPLIFICADA ==== */
QScrollBar:vertical {
    background-color: #FFE4E9;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #D94D73;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #C43D63;
}